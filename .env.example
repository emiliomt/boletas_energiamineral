# Copy to .env and adjust as needed. All values have working defaults.

# SQLAlchemy database URL. Default is a local SQLite file (zero setup).
# Can be swapped for Postgres later, e.g. postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./data/boletas.db

# Where uploaded original scans are stored on disk.
ORIGINALS_DIR=./data/originals

# Tesseract OCR language pack(s), '+'-joined (e.g. "spa+eng").
# Install additional language packs with: apt-get install tesseract-ocr-spa
OCR_LANGUAGE=spa+eng

# Directory holding the editable rule config CSVs.
RULES_CONFIG_DIR=./app/rules

# Composite confidence_score threshold (0-1) above which, with zero
# exceptions, a record is auto_processed instead of needs_review.
# Overridden per-deployment by exception_thresholds.csv if present there.
AUTO_PROCESS_CONFIDENCE_MIN=0.75

# --- OCR backend -------------------------------------------------------
# "tesseract" (offline, no key), "openai" (vision model, best on
# handwriting/photos), or "auto" (Tesseract, escalating to OpenAI only when
# a key is set AND Tesseract confidence is low). "auto" is safe with no key.
OCR_BACKEND=auto
# Needed for OCR_BACKEND=openai|auto. Get one at https://platform.openai.com.
OPENAI_API_KEY=
# Any vision-capable chat model.
OPENAI_OCR_MODEL=gpt-4o-mini
# Tesseract confidence (0-100) under which "auto" escalates to OpenAI.
OCR_FALLBACK_MIN_CONFIDENCE=70

# --- Auth (Supabase) ---------------------------------------------------
# The whole app requires the single admin login. There is no signup route;
# create the admin account with `python scripts/create_admin_user.py`
# (needs SUPABASE_SERVICE_ROLE_KEY set).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the admin session cookie. Has an insecure local-dev default so the
# app still runs with zero setup -- set this to a long random value in any
# real deployment (e.g. `openssl rand -hex 32`).
SESSION_SECRET_KEY=change-me-to-a-long-random-value

# --- WhatsApp ingest (Twilio) ------------------------------------------
# Public origin of this app with no trailing slash. Required in production
# so X-Twilio-Signature validates behind a reverse proxy (Railway, etc.).
PUBLIC_BASE_URL=https://your-app.up.railway.app
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Sandbox or production sender, display-only on the WhatsApp admin page.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated E.164 numbers allowed to upload. Leave empty to accept
# any sender (ok for the invite-only sandbox; set this in production).
WHATSAPP_ALLOWED_SENDERS=+5491112345678

# --- Database (Supabase Postgres, production) ---------------------------
# Leave DATABASE_URL as the sqlite default above for local dev. In
# production, point it at your Supabase project's Postgres connection
# string instead, e.g.:
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
