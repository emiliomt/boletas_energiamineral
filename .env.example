# Copy to .env and adjust as needed. All values have working defaults.

# SQLAlchemy database URL. Default is a local SQLite file (zero setup).
# Can be swapped for Postgres later, e.g. postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./data/boletas.db

# Where uploaded original scans are stored on disk.
ORIGINALS_DIR=./data/originals

# Tesseract OCR language pack(s), '+'-joined (e.g. "spa+eng").
# Install additional language packs with: apt-get install tesseract-ocr-spa
OCR_LANGUAGE=spa+eng

# Directory holding the editable rule config CSVs.
RULES_CONFIG_DIR=./app/rules

# Composite confidence_score threshold (0-1) above which, with zero
# exceptions, a record is auto_processed instead of needs_review.
# Overridden per-deployment by exception_thresholds.csv if present there.
AUTO_PROCESS_CONFIDENCE_MIN=0.75
